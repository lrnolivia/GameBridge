#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
    TARGET="$(readlink -- "$SOURCE")"
    if [[ "$TARGET" = /* ]]; then
        SOURCE="$TARGET"
    else
        SOURCE="$DIR/$TARGET"
    fi
done
HERE="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
exec python3 "$HERE/GameBridge-Lite.py" "$@"
